{
	"info": {
		"_postman_id": "11111111-2222-3333-4444-555555555555",
		"name": "My Backend Collection",
		"description": "Bộ API kiểm thử — có tiếng Việt & unicode: éè 😀",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "9876543210"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"id": "pre-login-id",
								"type": "text/javascript",
								"exec": [
									"pm.variables.set('trace', 'abc');",
									"",
									"// dòng trống ở trên phải được giữ"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"id": "test-login-id",
								"type": "text/javascript",
								"exec": [
									"const response = pm.response.json();",
									"pm.environment.set(\"access_token_v1\", response.data.accessToken);",
									"pm.globals.set(\"refresh_token\", response.data.refreshToken);",
									"pm.collectionVariables.set(\"user_id\", response.data.userId);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text",
								"description": "Kiểu nội dung"
							},
							{
								"key": "X-Disabled",
								"value": "1",
								"disabled": true
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login?debug=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							],
							"query": [
								{
									"key": "debug",
									"value": "1"
								},
								{
									"key": "skip",
									"value": "true",
									"disabled": true
								}
							]
						},
						"x-request-extension": {
							"keep": "me"
						}
					},
					"response": [
						{
							"name": "Login OK",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"url": {
									"raw": "{{base_url}}/auth/login",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"auth",
										"login"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\"success\":true,\"data\":{\"accessToken\":\"eyJ...\",\"userId\":12345678901234567890}}"
						}
					]
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{base_url}}/auth/me"
					}
				}
			],
			"auth": {
				"type": "noauth"
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.variables.set('order', (pm.variables.get('order') || '') + 'F');"
						]
					}
				}
			],
			"description": "Folder xác thực",
			"x-folder-extension": [1, 2, 3]
		},
		{
			"name": "Document Management",
			"item": [
				{
					"name": "Outgoing Documents",
					"item": [
						{
							"name": "List Documents",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/api/documents/:id?page=1.0",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"documents",
										":id"
									],
									"query": [
										{
											"key": "page",
											"value": "1.0"
										}
									],
									"variable": [
										{
											"key": "id",
											"value": "7"
										}
									]
								}
							},
							"response": []
						},
						{
							"name": "Create Document",
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "urlencoded",
									"urlencoded": [
										{
											"key": "title",
											"value": "Báo cáo",
											"type": "text"
										},
										{
											"key": "draft",
											"value": "true",
											"type": "text",
											"disabled": true
										}
									]
								},
								"url": {
									"raw": "{{base_url}}/api/documents",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"documents"
									]
								}
							},
							"response": []
						},
						{
							"name": "Upload",
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "formdata",
									"formdata": [
										{
											"key": "note",
											"value": "hello",
											"type": "text"
										},
										{
											"key": "file",
											"type": "file",
											"src": "/missing/report.pdf"
										}
									]
								},
								"url": "{{base_url}}/api/upload"
							},
							"response": []
						},
						{
							"name": "Delete Document",
							"request": {
								"method": "DELETE",
								"header": [],
								"url": {
									"raw": "{{base_url}}/api/documents/1",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"documents",
										"1"
									]
								}
							},
							"response": []
						}
					]
				},
				{
					"name": "Query Documents",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "{ documents { id } }",
								"variables": "{}"
							}
						},
						"url": "{{base_url}}/graphql"
					}
				}
			]
		},
		{
			"name": "Reports (empty folder)",
			"item": []
		},
		{
			"name": "Legacy kebab item",
			"x-unknown-kind": true
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token_v1}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.variables.set('order', (pm.variables.get('order') || '') + 'C');"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "https://api.example.com",
			"type": "string"
		},
		{
			"key": "unused",
			"value": "x",
			"type": "string",
			"disabled": true
		}
	],
	"protocolProfileBehavior": {
		"disableBodyPruning": true
	}
}
