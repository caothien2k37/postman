<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/envLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="italic" />

            <EditText
                android:id="@+id/reqName"
                style="@style/Widget.App.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Tên request"
                android:inputType="text"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/methodSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/url"
                    style="@style/Widget.App.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:hint="{{base_url}}/path"
                    android:inputType="textUri|textMultiLine|textNoSuggestions"
                    android:maxLines="4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Send" />
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:tabIndicatorColor="@color/primary"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/primary"
                app:tabTextColor="@color/text_secondary" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Params -->
                <LinearLayout
                    android:id="@+id/panelParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.App.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUERY PARAMS" />

                    <vn.ioc.minipostman.ui.KeyValueEditor
                        android:id="@+id/paramsEditor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/Widget.App.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PATH VARIABLES (:tên trong URL)" />

                    <vn.ioc.minipostman.ui.KeyValueEditor
                        android:id="@+id/pathVarsEditor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Authorization -->
                <LinearLayout
                    android:id="@+id/panelAuth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Widget.App.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOẠI AUTH" />

                    <Spinner
                        android:id="@+id/authType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/authFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/authNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Headers -->
                <LinearLayout
                    android:id="@+id/panelHeaders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Widget.App.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEADERS" />

                    <vn.ioc.minipostman.ui.KeyValueEditor
                        android:id="@+id/headersEditor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Body -->
                <LinearLayout
                    android:id="@+id/panelBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/bodyMode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <Spinner
                            android:id="@+id/rawLanguage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFormat"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Format" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/bodyRaw"
                        style="@style/Widget.App.Code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="6" />

                    <vn.ioc.minipostman.ui.KeyValueEditor
                        android:id="@+id/urlencodedEditor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <vn.ioc.minipostman.ui.KeyValueEditor
                        android:id="@+id/formdataEditor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/graphqlBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.App.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QUERY" />

                        <EditText
                            android:id="@+id/graphqlQuery"
                            style="@style/Widget.App.Code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:minLines="4" />

                        <TextView
                            style="@style/Widget.App.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VARIABLES (JSON)" />

                        <EditText
                            android:id="@+id/graphqlVars"
                            style="@style/Widget.App.Code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:minLines="2" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/bodyNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Scripts -->
                <LinearLayout
                    android:id="@+id/panelScripts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Widget.App.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRE-REQUEST SCRIPT" />

                    <EditText
                        android:id="@+id/preScript"
                        style="@style/Widget.App.Code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="pm.variables.set('trace', Date.now());"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="5" />

                    <TextView
                        style="@style/Widget.App.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POST-RESPONSE SCRIPT (TESTS)" />

                    <EditText
                        android:id="@+id/testScript"
                        style="@style/Widget.App.Code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="const r = pm.response.json();\npm.environment.set('access_token_v1', r.data.accessToken);"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="8" />

                    <TextView
                        style="@style/Widget.App.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SET BIẾN TỪ RESPONSE (kiểu cũ: tênBiến = đường.dẫn.json)" />

                    <EditText
                        android:id="@+id/extract"
                        style="@style/Widget.App.Code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="accessToken = data.accessToken"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="2" />
                </LinearLayout>

                <!-- Settings -->
                <LinearLayout
                    android:id="@+id/panelSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Widget.App.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THEO DÕI REDIRECT (riêng request này)" />

                    <Spinner
                        android:id="@+id/redirectMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/settingsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGlobalSettings"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cài đặt chung…" />
                </LinearLayout>
            </FrameLayout>

            <!-- Response -->
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chưa gửi request."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/responseTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabIndicatorColor="@color/primary"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/primary"
                app:tabTextColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/responseTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPretty"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pretty" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRaw"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Raw" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopy"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveResponse"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lưu file" />
            </LinearLayout>

            <TextView
                android:id="@+id/response"
                style="@style/Widget.App.Code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
